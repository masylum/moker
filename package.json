{
  "name": "mahjong-poker-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --report-unused-disable-directives --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm test && npm run test:worker",
    "typecheck": "tsc -b --pretty false",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:stud7": "tsx scripts/simulate-stud7.ts",
    "play": "tsx scripts/play.ts",
    "play:stud7": "tsx scripts/play-stud7.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.69",
    "@cloudflare/think": "^0.15.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "agents": "^0.20.1",
    "ai": "^7.0.0",
    "chat": "^4.38.0",
    "rand-seed": "^3.0.0",
    "react": "^19.2.1",
    "solid-js": "^1.9.14",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^24.0.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
